{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ClipLocal",
  "version": "0.1.0",
  "identifier": "com.cliplocal.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../.output/public"
  },
  "app": {
    "windows": [
      {
        "title": "ClipLocal",
        "width": 1200,
        "height": 800,
        "resizable": true,
        "fullscreen": false,
        "label": "main",
        "url": "/"
      },
      {
        "title": "APM Overlay",
        "width": 200,
        "height": 80,
        "resizable": false,
        "fullscreen": false,
        "alwaysOnTop": true,
        "decorations": false,
        "transparent": true,
        "visible": false,
        "label": "overlay",
        "url": "/overlay"
      }
    ],
    "security": {
      "csp": "default-src 'self' http://localhost:8765; img-src 'self' http://localhost:8765 data:; style-src 'self' 'unsafe-inline'"
    },
    "trayIcon": {
      "iconPath": "icons/icon.png",
      "iconAsTemplate": true
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
